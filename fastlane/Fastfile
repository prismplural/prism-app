default_platform(:ios)

require "fileutils"
require "shellwords"
require "tmpdir"
require "yaml"

# Shared App Store Connect API key config
# Requires env vars: ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_FILEPATH
def asc_api_key
  params = {
    key_id: ENV["ASC_KEY_ID"],
    issuer_id: ENV["ASC_ISSUER_ID"],
  }
  params[:key_filepath] = ENV["ASC_KEY_FILEPATH"] if ENV["ASC_KEY_FILEPATH"]
  app_store_connect_api_key(**params)
end

# Build the --dart-define flag string that bakes the beta relay registration
# token and BuildInfo fields into the binary -- matches app/build.sh's
# compute_build_info. The token is read from ~/.config/prism/.env.testflight
# by default and is required for internal/TestFlight lanes so beta testers
# don't have to type it by hand.
def build_info_defines
  token = beta_registration_token

  (build_metadata_defines + [
    "--dart-define=PRISM_BETA_REGISTRATION_TOKEN=#{token}",
  ]).join(" ")
end

def build_metadata_defines
  app_version = File.read("../pubspec.yaml").match(/^version:\s*(\S+)/)&.captures&.first || "unknown"
  git_rev = `git rev-parse --short HEAD`.strip
  git_describe = `git describe --always --dirty`.strip
  git_branch = `git rev-parse --abbrev-ref HEAD`.strip
  built_at = Time.now.utc.strftime("%Y-%m-%dT%H:%M:%SZ")

  [
    "--dart-define=APP_VERSION=#{app_version}",
    "--dart-define=GIT_REV=#{git_rev}",
    "--dart-define=GIT_DESCRIBE=#{git_describe}",
    "--dart-define=GIT_BRANCH=#{git_branch}",
    "--dart-define=BUILT_AT=#{built_at}",
  ]
end

def beta_registration_token
  config_env_file = ENV["PRISM_TESTFLIGHT_ENV_FILE"] || File.expand_path("~/.config/prism/.env.testflight")
  legacy_env_file = File.expand_path("../../.env.testflight", __dir__)
  env_file = File.exist?(config_env_file) ? config_env_file : legacy_env_file
  unless File.exist?(env_file)
    UI.user_error!("TestFlight env file not found at #{config_env_file} or #{legacy_env_file}")
  end
  File.foreach(env_file) do |line|
    line = line.strip
    next if line.empty? || line.start_with?("#")
    k, v = line.split("=", 2)
    ENV[k] ||= v if k && v
  end
  token = ENV["PRISM_BETA_REGISTRATION_TOKEN"]
  UI.user_error!("PRISM_BETA_REGISTRATION_TOKEN not set in #{env_file}") if token.nil? || token.empty?
  token
end

def scrubbed_flutter_env
  # /usr/bin first so xcodebuild's exportArchive picks system rsync; Homebrew
  # rsync 3.4+ rejects the args Xcode passes and the IPA export fails.
  'env -u BUNDLE_GEMFILE -u BUNDLE_PATH -u BUNDLE_BIN_PATH -u RUBYOPT -u GEM_HOME -u GEM_PATH PATH="/usr/bin:/opt/homebrew/bin:$PATH"'
end

def app_version
  File.read(File.expand_path("../pubspec.yaml", __dir__)).match(/^version:\s*(\S+)/)&.captures&.first || "unknown"
end

def android_symbols_archive_dir
  version = app_version.gsub(/[^0-9A-Za-z._+-]/, "_").tr("+", "_")
  git_rev = `git rev-parse --short HEAD`.strip
  built_at = Time.now.utc.strftime("%Y%m%dT%H%M%SZ")
  root = ENV["PRISM_ANDROID_SYMBOLS_DIR"] || File.expand_path("~/.config/prism/android-symbols")
  File.expand_path("#{version}-#{git_rev}-#{built_at}", root)
end

def copy_if_present(source, destination)
  return nil unless source && File.exist?(source)

  FileUtils.mkdir_p(File.dirname(destination))
  FileUtils.cp(source, destination)
  destination
end

def latest_file(pattern)
  Dir[pattern].select { |path| File.file?(path) }.max_by { |path| File.mtime(path) }
end

def release_store_note
  version_short = app_version.split("+").first
  notes_root = ENV["PRISM_RELEASE_NOTES_DIR"] ||
    File.expand_path("../../prism-workspace/docs/release", __dir__)
  notes_file = File.join(notes_root, "#{version_short}-store-release-notes.md")
  UI.user_error!("Release notes file not found: #{notes_file}") unless File.exist?(notes_file)

  match = File.read(notes_file, encoding: "UTF-8").match(/\A---\n(.*?)\n---/m)
  UI.user_error!("No YAML frontmatter in #{notes_file}") unless match

  meta = YAML.safe_load(match[1])
  note = meta["store_note"]&.strip
  UI.user_error!("store_note missing from #{notes_file} frontmatter") if note.nil? || note.empty?

  limit = meta["store_note_limit"] || 500
  if note.length > limit
    UI.user_error!("store_note in #{notes_file} is #{note.length} chars, over the #{limit} cap")
  end

  note
end

def github_release_tag
  tag = ENV["PRISM_GITHUB_RELEASE_TAG"].to_s.strip
  return tag unless tag.empty?

  exact_tag = `git describe --tags --exact-match 2>/dev/null`.strip
  return exact_tag unless exact_tag.empty?

  "v#{app_version.split("+").first}"
end

platform :ios do
  desc "Build and upload to TestFlight, distribute to the Prism Private Beta group"
  lane :beta do
    note = release_store_note
    defines = build_info_defines
    # Unset bundler env vars fastlane injects — they break CocoaPods when
    # flutter invokes pod install with the wrong Ruby gem environment.
    sh("cd .. && #{scrubbed_flutter_env} flutter build ipa --release #{defines}")

    ipa_path = Dir[File.expand_path("../build/ios/ipa/*.ipa", __dir__)].first
    UI.user_error!("No IPA found in build/ios/ipa/") unless ipa_path

    upload_to_testflight(
      api_key: asc_api_key,
      ipa: ipa_path,
      distribute_external: true,
      notify_external_testers: true,
      groups: ["Prism Private Beta"],
      changelog: note,
    )
  end

  desc "Build unsigned sideload IPA and upload it to the GitHub release"
  lane :sideload do
    defines = build_metadata_defines.join(" ")
    version = app_version
    git_rev = `git rev-parse --short HEAD`.strip
    artifact_dir = File.expand_path("../build/mobile-artifacts/ios", __dir__)
    ipa_path = File.join(artifact_dir, "Prism-#{version}-#{git_rev}-ios-unsigned.ipa")
    checksum_path = "#{ipa_path}.sha256"

    FileUtils.mkdir_p(artifact_dir)
    sh("cd .. && #{scrubbed_flutter_env} flutter build ios --release --no-codesign #{defines}")
    sh("cd .. && scripts/package_unsigned_ipa.sh #{Shellwords.escape(ipa_path)}")
    sh("cd #{Shellwords.escape(artifact_dir)} && shasum -a 256 #{Shellwords.escape(File.basename(ipa_path))} > #{Shellwords.escape(File.basename(checksum_path))}")

    tag = github_release_tag
    sh("cd .. && gh release upload #{Shellwords.escape(tag)} #{Shellwords.escape(ipa_path)} #{Shellwords.escape(checksum_path)} --clobber")
    UI.success("Uploaded iOS sideload IPA to GitHub release #{tag}")
  end
end

platform :mac do
  desc "Build and upload to TestFlight, distribute to the Prism Private Beta group"
  lane :beta do
    note = release_store_note
    defines = build_info_defines

    # flutter build writes dart-defines into macos/Flutter/ephemeral/Flutter-Generated.xcconfig
    # so the subsequent xcodebuild archive picks them up without re-specifying them.
    # Unset bundler env vars fastlane injects — they break CocoaPods when
    # flutter invokes pod install with the wrong Ruby gem environment.
    sh("cd .. && #{scrubbed_flutter_env} flutter build macos --release #{defines}")

    build_mac_app(
      workspace: "macos/Runner.xcworkspace",
      scheme: "Runner",
      configuration: "Release",
      export_method: "app-store",
      export_options: File.expand_path("macos_export_options.plist", __dir__),
      output_directory: File.expand_path("../build/macos/export", __dir__),
      skip_package_pkg: false,
      xcargs: "-allowProvisioningUpdates",
    )

    pkg_path = Dir[File.expand_path("../build/macos/export/*.pkg", __dir__)].first
    UI.user_error!("No pkg found in build/macos/export/") unless pkg_path

    upload_to_testflight(
      api_key: asc_api_key,
      pkg: pkg_path,
      distribute_external: true,
      notify_external_testers: true,
      groups: ["Prism Private Beta"],
      changelog: note,
    )
  end
end

platform :android do
  desc "Build and upload to the Play Store closed beta testing track"
  lane :beta do
    note = release_store_note
    defines = build_info_defines
    symbols_dir = android_symbols_archive_dir
    dart_symbols_dir = File.join(symbols_dir, "dart")
    FileUtils.mkdir_p(dart_symbols_dir)

    sh("cd .. && flutter build appbundle --release --split-debug-info=#{Shellwords.escape(dart_symbols_dir)} #{defines}")

    play_store_json_key = ENV["PLAY_STORE_JSON_KEY"]
    default_play_store_json_key = File.expand_path("~/.config/prism/play-store-key.json")
    if (play_store_json_key.nil? || play_store_json_key.empty?) && File.exist?(default_play_store_json_key)
      play_store_json_key = default_play_store_json_key
    end
    UI.user_error!("PLAY_STORE_JSON_KEY not set and #{default_play_store_json_key} not found") if play_store_json_key.nil? || play_store_json_key.empty?

    aab_path = File.expand_path("../build/app/outputs/bundle/release/app-release.aab", __dir__)
    native_symbols_zip = latest_file(File.expand_path("../build/app/outputs/native-debug-symbols/**/*.zip", __dir__))
    r8_mapping = File.expand_path("../build/app/outputs/mapping/release/mapping.txt", __dir__)

    archived_native_symbols = copy_if_present(native_symbols_zip, File.join(symbols_dir, "native-debug-symbols.zip"))
    archived_r8_mapping = copy_if_present(r8_mapping, File.join(symbols_dir, "mapping.txt"))

    dart_symbol_files = Dir[File.join(dart_symbols_dir, "*.symbols")].sort
    UI.user_error!("No Flutter Dart symbol files found in #{dart_symbols_dir}") if dart_symbol_files.empty?
    UI.important("No native debug symbols zip found under build/app/outputs/native-debug-symbols") unless archived_native_symbols
    UI.important("No R8 mapping.txt found under build/app/outputs/mapping/release") unless archived_r8_mapping

    File.write(
      File.join(symbols_dir, "manifest.txt"),
      [
        "version=#{app_version}",
        "git_rev=#{`git rev-parse --short HEAD`.strip}",
        "git_describe=#{`git describe --always --dirty`.strip}",
        "built_at=#{Time.now.utc.strftime("%Y-%m-%dT%H:%M:%SZ")}",
        "aab=#{aab_path}",
        "dart_symbols_dir=#{dart_symbols_dir}",
        "dart_symbols=#{dart_symbol_files.map { |path| File.basename(path) }.join(",")}",
        "native_debug_symbols=#{archived_native_symbols || ""}",
        "r8_mapping=#{archived_r8_mapping || ""}",
      ].join("\n") + "\n"
    )

    mapping_paths = [native_symbols_zip, r8_mapping].compact.select { |path| File.exist?(path) }

    upload_options = {
      track: "beta",
      aab: aab_path,
      json_key: play_store_json_key,
      package_name: "com.prismplural.prism",
      release_status: "completed",
    }
    upload_options[:mapping_paths] = mapping_paths unless mapping_paths.empty?

    # supply takes release notes via a metadata-dir layout; write the
    # changelog into a tmpdir so nothing persists under fastlane/metadata/.
    Dir.mktmpdir("prism-supply-metadata") do |meta_dir|
      changelog_dir = File.join(meta_dir, "en-US", "changelogs")
      FileUtils.mkdir_p(changelog_dir)
      File.write(File.join(changelog_dir, "#{app_version.split("+").last}.txt"), note)
      upload_to_play_store(**upload_options, metadata_path: meta_dir)
    end
    UI.success("Archived Android symbol files at #{symbols_dir}")
  end
end
