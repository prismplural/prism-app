default_platform(:ios)

require "fileutils"
require "json"
require "open3"
require "shellwords"
require "tmpdir"
require "yaml"

# Resolve a config path that may be absolute, ~ relative, or relative to the
# repo root (so ASC_KEY_FILEPATH=AuthKey_X.p8 works in CI checkouts too).
def expand_config_path(path)
  expanded = File.expand_path(path)
  return expanded if File.exist?(expanded)

  app_relative = File.expand_path(path, File.expand_path("..", __dir__))
  File.exist?(app_relative) ? app_relative : expanded
end

# Shared App Store Connect API key config
# Requires env vars: ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_FILEPATH
def asc_api_key
  params = {
    key_id: ENV["ASC_KEY_ID"],
    issuer_id: ENV["ASC_ISSUER_ID"],
  }
  params[:key_filepath] = expand_config_path(ENV["ASC_KEY_FILEPATH"]) if ENV["ASC_KEY_FILEPATH"]
  app_store_connect_api_key(**params)
end

# Build the --dart-define flag string that bakes the beta relay registration
# token and BuildInfo fields into the binary -- matches app/build.sh's
# compute_build_info. The token is read from ~/.config/prism/.env.testflight
# by default and is required for internal/TestFlight lanes so beta testers
# don't have to type it by hand.
def build_info_defines
  token = beta_registration_token

  (build_metadata_defines + [
    "--dart-define=PRISM_BETA_REGISTRATION_TOKEN=#{token}",
  ]).join(" ")
end

def build_metadata_defines
  app_version = File.read("../pubspec.yaml").match(/^version:\s*(\S+)/)&.captures&.first || "unknown"
  git_rev = `git rev-parse --short HEAD`.strip
  git_describe = `git describe --always --dirty`.strip
  git_branch = `git rev-parse --abbrev-ref HEAD`.strip
  built_at = Time.now.utc.strftime("%Y-%m-%dT%H:%M:%SZ")

  [
    "--dart-define=APP_VERSION=#{app_version}",
    "--dart-define=GIT_REV=#{git_rev}",
    "--dart-define=GIT_DESCRIBE=#{git_describe}",
    "--dart-define=GIT_BRANCH=#{git_branch}",
    "--dart-define=BUILT_AT=#{built_at}",
  ]
end

def beta_registration_token
  config_env_file = ENV["PRISM_TESTFLIGHT_ENV_FILE"] || File.expand_path("~/.config/prism/.env.testflight")
  legacy_env_file = File.expand_path("../../.env.testflight", __dir__)
  env_file = File.exist?(config_env_file) ? config_env_file : legacy_env_file
  unless File.exist?(env_file)
    UI.user_error!("TestFlight env file not found at #{config_env_file} or #{legacy_env_file}")
  end
  File.foreach(env_file) do |line|
    line = line.strip
    next if line.empty? || line.start_with?("#")
    k, v = line.split("=", 2)
    ENV[k] ||= v if k && v
  end
  token = ENV["PRISM_BETA_REGISTRATION_TOKEN"]
  UI.user_error!("PRISM_BETA_REGISTRATION_TOKEN not set in #{env_file}") if token.nil? || token.empty?
  token
end

def scrubbed_flutter_env
  # /usr/bin first so xcodebuild's exportArchive picks system rsync; Homebrew
  # rsync 3.4+ rejects the args Xcode passes and the IPA export fails.
  'env -u BUNDLE_GEMFILE -u BUNDLE_PATH -u BUNDLE_BIN_PATH -u RUBYOPT -u GEM_HOME -u GEM_PATH PATH="/usr/bin:/opt/homebrew/bin:$PATH"'
end

def app_version
  File.read(File.expand_path("../pubspec.yaml", __dir__)).match(/^version:\s*(\S+)/)&.captures&.first || "unknown"
end

def mac_bundle_identifier
  config = File.read(File.expand_path("../macos/Runner/Configs/AppInfo.xcconfig", __dir__))
  config.match(/^PRODUCT_BUNDLE_IDENTIFIER\s*=\s*(\S+)/)&.captures&.first || "com.prismplural.prism"
end

def android_symbols_archive_dir
  version = app_version.gsub(/[^0-9A-Za-z._+-]/, "_").tr("+", "_")
  git_rev = `git rev-parse --short HEAD`.strip
  built_at = Time.now.utc.strftime("%Y%m%dT%H%M%SZ")
  root = ENV["PRISM_ANDROID_SYMBOLS_DIR"] || File.expand_path("~/.config/prism/android-symbols")
  File.expand_path("#{version}-#{git_rev}-#{built_at}", root)
end

def copy_if_present(source, destination)
  return nil unless source && File.exist?(source)

  FileUtils.mkdir_p(File.dirname(destination))
  FileUtils.cp(source, destination)
  destination
end

def latest_file(pattern)
  Dir[pattern].select { |path| File.file?(path) }.max_by { |path| File.mtime(path) }
end

def release_store_note
  version_short = app_version.split("+").first
  notes_root = ENV["PRISM_RELEASE_NOTES_DIR"] ||
    File.expand_path("../../prism-workspace/docs/release", __dir__)
  notes_file = File.join(notes_root, "#{version_short}-store-release-notes.md")
  UI.user_error!("Release notes file not found: #{notes_file}") unless File.exist?(notes_file)

  match = File.read(notes_file, encoding: "UTF-8").match(/\A---\n(.*?)\n---/m)
  UI.user_error!("No YAML frontmatter in #{notes_file}") unless match

  meta = YAML.safe_load(match[1])
  note = meta["store_note"]&.strip
  UI.user_error!("store_note missing from #{notes_file} frontmatter") if note.nil? || note.empty?

  limit = meta["store_note_limit"] || 500
  if note.length > limit
    UI.user_error!("store_note in #{notes_file} is #{note.length} chars, over the #{limit} cap")
  end

  note
end

def github_release_tag
  tag = ENV["PRISM_GITHUB_RELEASE_TAG"].to_s.strip
  return tag unless tag.empty?

  exact_tag = `git describe --tags --exact-match 2>/dev/null`.strip
  return exact_tag unless exact_tag.empty?

  "v#{app_version.split("+").first}"
end

def apple_team_id
  team_id = ENV["PRISM_APPLE_TEAM_ID"].to_s.strip
  team_id.empty? ? "GF2W9X3Y6L" : team_id
end

def developer_id_signing_certificate
  certificate = ENV["PRISM_MAC_DEVELOPER_ID_APPLICATION"].to_s.strip
  certificate.empty? ? "Developer ID Application" : certificate
end

def mac_developer_id_runtime_entitlements
  {
    "com.apple.security.app-sandbox" => true,
    "com.apple.security.network.client" => true,
    "com.apple.security.files.user-selected.read-write" => true,
    "com.apple.security.device.camera" => true,
    "com.apple.security.device.audio-input" => true,
  }
end

def mac_developer_id_entitlements_plist
  <<~PLIST
    <?xml version="1.0" encoding="UTF-8"?>
    <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "https://www.apple.com/DTDs/PropertyList-1.0.dtd">
    <plist version="1.0">
    <dict>
      <key>com.apple.security.app-sandbox</key>
      <true/>
      <key>com.apple.security.network.client</key>
      <true/>
      <key>com.apple.security.files.user-selected.read-write</key>
      <true/>
      <key>com.apple.security.device.camera</key>
      <true/>
      <key>com.apple.security.device.audio-input</key>
      <true/>
    </dict>
    </plist>
  PLIST
end

def mac_developer_id_export_options
  {
    "method" => "developer-id",
    "signingCertificate" => developer_id_signing_certificate,
    "signingStyle" => "automatic",
    "teamID" => apple_team_id,
  }
end

def mac_developer_id_xcargs
  Shellwords.join([
    "-allowProvisioningUpdates",
    "DEVELOPMENT_TEAM=#{apple_team_id}",
    "CODE_SIGN_STYLE=Automatic",
    "ENABLE_HARDENED_RUNTIME=YES",
  ])
end

# Build the xcrun notarytool credential args. Prefers a keychain profile
# (xcrun notarytool store-credentials), falls back to ASC API key env vars,
# then to an Apple ID + app-specific password pair.
def notarytool_args
  profile = ENV["PRISM_NOTARY_KEYCHAIN_PROFILE"].to_s.strip
  return Shellwords.join(["--keychain-profile", profile]) unless profile.empty?

  key_id = (ENV["PRISM_NOTARY_KEY_ID"] || ENV["ASC_KEY_ID"]).to_s.strip
  issuer_id = (ENV["PRISM_NOTARY_ISSUER_ID"] || ENV["ASC_ISSUER_ID"]).to_s.strip
  key_filepath = (ENV["PRISM_NOTARY_KEY_FILEPATH"] || ENV["ASC_KEY_FILEPATH"]).to_s.strip
  unless key_id.empty? || key_filepath.empty?
    args = ["--key", expand_config_path(key_filepath), "--key-id", key_id]
    args += ["--issuer", issuer_id] unless issuer_id.empty?
    return Shellwords.join(args)
  end

  apple_id = (ENV["PRISM_NOTARY_APPLE_ID"] || ENV["FASTLANE_USER"]).to_s.strip
  password = (ENV["PRISM_NOTARY_PASSWORD"] || ENV["FASTLANE_APPLE_APPLICATION_SPECIFIC_PASSWORD"]).to_s.strip
  unless apple_id.empty? || password.empty?
    return Shellwords.join(["--apple-id", apple_id, "--team-id", apple_team_id, "--password", password])
  end

  UI.user_error!(
    "No notarization credentials found. Set PRISM_NOTARY_KEYCHAIN_PROFILE, " \
    "or ASC_KEY_ID/ASC_ISSUER_ID/ASC_KEY_FILEPATH, " \
    "or PRISM_NOTARY_APPLE_ID/PRISM_NOTARY_PASSWORD."
  )
end

def exported_mac_app_path(output_directory)
  apps = Dir[File.join(output_directory, "*.app")]
  apps = Dir[File.join(output_directory, "**", "*.app")] if apps.empty?
  app_path = apps.first
  UI.user_error!("No exported .app found in #{output_directory}") unless app_path
  app_path
end

def developer_id_sign_macos_app(app_path)
  identity = developer_id_signing_certificate
  profile_path = File.join(app_path, "Contents", "embedded.provisionprofile")
  frameworks_dir = File.join(app_path, "Contents", "Frameworks")

  unless Dir.exist?(frameworks_dir)
    UI.user_error!("No Frameworks directory found in exported app: #{frameworks_dir}")
  end

  FileUtils.rm_f(profile_path)

  sign_args = [
    "codesign",
    "--force",
    "--options", "runtime",
    "--timestamp",
    "--sign", identity,
  ]

  Dir[File.join(frameworks_dir, "*.{framework,dylib,so}")].sort.each do |target|
    sh(Shellwords.join(sign_args + [target]))
  end

  Dir.mktmpdir("prism-macos-developer-id-entitlements") do |dir|
    entitlements_path = File.join(dir, "entitlements.plist")
    File.write(entitlements_path, mac_developer_id_entitlements_plist)
    sh(Shellwords.join(sign_args + ["--entitlements", entitlements_path, app_path]))
  end
end

def developer_id_sign_macos_dmg(dmg_path)
  sh(
    Shellwords.join([
      "codesign",
      "--force",
      "--timestamp",
      "--sign", developer_id_signing_certificate,
      dmg_path,
    ])
  )
end

def verify_macos_release_app(app_path, label: "exported macOS app")
  sh("codesign --verify --deep --strict --verbose=2 #{Shellwords.escape(app_path)}")
  verify_macos_release_entitlements(app_path, label: label)
end

def verify_macos_release_entitlements(app_path, label: "exported macOS app")
  profile_path = File.join(app_path, "Contents", "embedded.provisionprofile")
  if File.exist?(profile_path)
    UI.user_error!(
      "#{label} still contains embedded.provisionprofile; " \
      "this can make AMFI kill the app at launch."
    )
  end

  stdout, stderr, status = Open3.capture3(
    "codesign -d --entitlements :- #{Shellwords.escape(app_path)}"
  )
  unless status.success?
    UI.user_error!("Could not read #{label} entitlements:\n#{stderr}")
  end
  if stdout.strip.empty?
    UI.user_error!(
      "#{label} has no entitlements. Refusing to package a " \
      "Developer ID build that would fail sandbox/keychain operations."
    )
  end

  Dir.mktmpdir("prism-macos-entitlements") do |dir|
    entitlements_path = File.join(dir, "entitlements.plist")
    File.write(entitlements_path, stdout)
    json, json_err, json_status = Open3.capture3(
      "plutil -convert json -o - #{Shellwords.escape(entitlements_path)}"
    )
    unless json_status.success?
      UI.user_error!("Could not parse #{label} entitlements:\n#{json_err}")
    end

    entitlements = JSON.parse(json)
    expected = mac_developer_id_runtime_entitlements
    mismatches = expected.filter_map do |key, expected_value|
      actual_value = entitlements[key]
      next if actual_value == expected_value

      "#{key}=#{actual_value.inspect} (expected #{expected_value.inspect})"
    end

    provisioning_entitlements = [
      "com.apple.application-identifier",
      "com.apple.developer.team-identifier",
      "keychain-access-groups",
    ]
    provisioning_entitlements.each do |key|
      next unless entitlements.key?(key)

      mismatches << "#{key}=#{entitlements[key].inspect} (must be absent in Developer ID DMG)"
    end

    if entitlements["com.apple.security.get-task-allow"] == true
      mismatches << "com.apple.security.get-task-allow=true (must not be true in Developer ID exports)"
    end

    unless mismatches.empty?
      UI.user_error!(
        "#{label} entitlements are not release-safe:\n" \
        "#{mismatches.map { |m| "  - #{m}" }.join("\n")}"
      )
    end
  end

  UI.success("Verified #{label} signing and entitlements")
end

def verify_macos_release_dmg(dmg_path)
  sh("hdiutil verify #{Shellwords.escape(dmg_path)}")
  sh("codesign --verify --strict --verbose=2 #{Shellwords.escape(dmg_path)}")

  Dir.mktmpdir("prism-macos-dmg-mount") do |mount_point|
    attached = false
    begin
      _stdout, stderr, status = Open3.capture3(
        "hdiutil attach -nobrowse -readonly " \
        "-mountpoint #{Shellwords.escape(mount_point)} " \
        "#{Shellwords.escape(dmg_path)}"
      )
      unless status.success?
        UI.user_error!("Could not mount macOS DMG for verification:\n#{stderr}")
      end
      attached = true

      app_path = File.join(mount_point, "Prism.app")
      unless Dir.exist?(app_path)
        app_path = Dir[File.join(mount_point, "*.app")].first
        app_path ||= Dir[File.join(mount_point, "**", "*.app")].first
      end
      UI.user_error!("Mounted macOS DMG does not contain Prism.app") unless app_path

      verify_macos_release_app(app_path, label: "macOS DMG app")
    ensure
      if attached
        sh("hdiutil detach #{Shellwords.escape(mount_point)} -quiet")
      end
    end
  end

  UI.success("Verified macOS DMG payload")
end

def create_macos_dmg(app_path, dmg_path, volume_name)
  staging_dir = File.expand_path("../build/macos/dmg-staging", __dir__)
  staged_app = File.join(staging_dir, "Prism.app")

  FileUtils.rm_rf(staging_dir)
  FileUtils.mkdir_p(staging_dir)
  FileUtils.cp_r(app_path, staged_app)
  FileUtils.ln_s("/Applications", File.join(staging_dir, "Applications"))
  FileUtils.mkdir_p(File.dirname(dmg_path))
  FileUtils.rm_f(dmg_path)

  sh(
    "hdiutil create " \
    "-volname #{Shellwords.escape(volume_name)} " \
    "-srcfolder #{Shellwords.escape(staging_dir)} " \
    "-ov -format UDZO " \
    "#{Shellwords.escape(dmg_path)}"
  )
end

def notarize_and_staple(path)
  timeout = ENV["PRISM_NOTARY_TIMEOUT"].to_s.strip
  timeout_arg = timeout.empty? ? "" : " --timeout #{Shellwords.escape(timeout)}"

  sh("xcrun notarytool submit #{Shellwords.escape(path)} #{notarytool_args} --wait#{timeout_arg}")
  sh("xcrun stapler staple #{Shellwords.escape(path)}")
  sh("xcrun stapler validate #{Shellwords.escape(path)}")
end

def write_sha256_file(path)
  checksum_path = "#{path}.sha256"
  sh(
    "cd #{Shellwords.escape(File.dirname(path))} && " \
    "shasum -a 256 #{Shellwords.escape(File.basename(path))} > " \
    "#{Shellwords.escape(File.basename(checksum_path))}"
  )
  checksum_path
end

def github_release_upload(paths)
  tag = github_release_tag
  escaped_paths = paths.map { |path| Shellwords.escape(path) }.join(" ")
  sh("cd .. && gh release upload #{Shellwords.escape(tag)} #{escaped_paths} --clobber")
  tag
end

platform :ios do
  desc "Build and upload to TestFlight, distribute to the Prism Private Beta group"
  lane :beta do
    note = release_store_note
    defines = build_info_defines
    # Unset bundler env vars fastlane injects — they break CocoaPods when
    # flutter invokes pod install with the wrong Ruby gem environment.
    sh("cd .. && #{scrubbed_flutter_env} flutter build ipa --release #{defines}")

    ipa_path = Dir[File.expand_path("../build/ios/ipa/*.ipa", __dir__)].first
    UI.user_error!("No IPA found in build/ios/ipa/") unless ipa_path

    upload_to_testflight(
      api_key: asc_api_key,
      ipa: ipa_path,
      distribute_external: true,
      notify_external_testers: true,
      groups: ["Prism Private Beta"],
      changelog: note,
    )
  end

  desc "Build unsigned sideload IPA and upload it to the GitHub release"
  lane :sideload do
    defines = build_metadata_defines.join(" ")
    version = app_version
    git_rev = `git rev-parse --short HEAD`.strip
    artifact_dir = File.expand_path("../build/mobile-artifacts/ios", __dir__)
    ipa_path = File.join(artifact_dir, "Prism-#{version}-#{git_rev}-ios-unsigned.ipa")
    checksum_path = "#{ipa_path}.sha256"

    FileUtils.mkdir_p(artifact_dir)
    sh("cd .. && #{scrubbed_flutter_env} flutter build ios --release --no-codesign #{defines}")
    sh("cd .. && scripts/package_unsigned_ipa.sh #{Shellwords.escape(ipa_path)}")
    write_sha256_file(ipa_path)

    tag = github_release_upload([ipa_path, checksum_path])
    UI.success("Uploaded iOS sideload IPA to GitHub release #{tag}")
  end
end

platform :mac do
  desc "Build and upload to TestFlight, distribute to the Prism Private Beta group"
  lane :beta do
    note = release_store_note
    defines = build_info_defines

    # flutter build writes dart-defines into macos/Flutter/ephemeral/Flutter-Generated.xcconfig
    # so the subsequent xcodebuild archive picks them up without re-specifying them.
    # Unset bundler env vars fastlane injects — they break CocoaPods when
    # flutter invokes pod install with the wrong Ruby gem environment.
    sh("cd .. && #{scrubbed_flutter_env} flutter build macos --release #{defines}")

    build_mac_app(
      workspace: "macos/Runner.xcworkspace",
      scheme: "Runner",
      configuration: "Release",
      export_method: "app-store",
      export_options: File.expand_path("macos_export_options.plist", __dir__),
      output_directory: File.expand_path("../build/macos/export", __dir__),
      skip_package_pkg: false,
      xcargs: "-allowProvisioningUpdates",
    )

    pkg_path = Dir[File.expand_path("../build/macos/export/*.pkg", __dir__)].first
    UI.user_error!("No pkg found in build/macos/export/") unless pkg_path

    upload_to_testflight(
      api_key: asc_api_key,
      pkg: pkg_path,
      distribute_external: true,
      notify_external_testers: true,
      groups: ["Prism Private Beta"],
      changelog: note,
    )
  end

  desc "Build signed/notarized Developer ID DMG and upload it to the GitHub release"
  lane :sideload do
    defines = build_metadata_defines.join(" ")
    version = app_version
    export_dir = File.expand_path("../build/macos/developer-id/export", __dir__)
    artifact_dir = File.expand_path("../build/release-artifacts/macos", __dir__)
    dmg_path = File.join(artifact_dir, "Prism-#{version}-macos.dmg")

    # flutter build writes dart-defines into macos/Flutter/ephemeral/Flutter-Generated.xcconfig
    # so the subsequent xcodebuild archive picks them up without re-specifying them.
    sh("cd .. && #{scrubbed_flutter_env} flutter build macos --release #{defines}")

    FileUtils.rm_rf(export_dir)
    build_mac_app(
      workspace: "macos/Runner.xcworkspace",
      scheme: "Runner",
      configuration: "Release",
      export_method: "developer-id",
      export_options: mac_developer_id_export_options,
      export_team_id: apple_team_id,
      output_directory: export_dir,
      skip_package_pkg: true,
      xcargs: mac_developer_id_xcargs,
    )

    app_path = exported_mac_app_path(export_dir)
    developer_id_sign_macos_app(app_path)
    verify_macos_release_app(app_path)

    create_macos_dmg(app_path, dmg_path, "Prism #{version.split("+").first}")
    developer_id_sign_macos_dmg(dmg_path)
    notarize_and_staple(dmg_path)
    sh("spctl --assess --type open --context context:primary-signature --verbose=4 #{Shellwords.escape(dmg_path)}")
    verify_macos_release_dmg(dmg_path)

    checksum_path = write_sha256_file(dmg_path)
    tag = github_release_upload([dmg_path, checksum_path])
    UI.success("Uploaded macOS Developer ID DMG to GitHub release #{tag}")
  end
end

platform :android do
  desc "Build and upload to the Play Store closed beta testing track"
  lane :beta do
    note = release_store_note
    defines = build_info_defines
    symbols_dir = android_symbols_archive_dir
    dart_symbols_dir = File.join(symbols_dir, "dart")
    FileUtils.mkdir_p(dart_symbols_dir)

    sh("cd .. && flutter build appbundle --release --split-debug-info=#{Shellwords.escape(dart_symbols_dir)} #{defines}")

    play_store_json_key = ENV["PLAY_STORE_JSON_KEY"]
    default_play_store_json_key = File.expand_path("~/.config/prism/play-store-key.json")
    if (play_store_json_key.nil? || play_store_json_key.empty?) && File.exist?(default_play_store_json_key)
      play_store_json_key = default_play_store_json_key
    end
    UI.user_error!("PLAY_STORE_JSON_KEY not set and #{default_play_store_json_key} not found") if play_store_json_key.nil? || play_store_json_key.empty?

    aab_path = File.expand_path("../build/app/outputs/bundle/release/app-release.aab", __dir__)
    native_symbols_zip = latest_file(File.expand_path("../build/app/outputs/native-debug-symbols/**/*.zip", __dir__))
    r8_mapping = File.expand_path("../build/app/outputs/mapping/release/mapping.txt", __dir__)

    archived_native_symbols = copy_if_present(native_symbols_zip, File.join(symbols_dir, "native-debug-symbols.zip"))
    archived_r8_mapping = copy_if_present(r8_mapping, File.join(symbols_dir, "mapping.txt"))

    dart_symbol_files = Dir[File.join(dart_symbols_dir, "*.symbols")].sort
    UI.user_error!("No Flutter Dart symbol files found in #{dart_symbols_dir}") if dart_symbol_files.empty?
    UI.important("No native debug symbols zip found under build/app/outputs/native-debug-symbols") unless archived_native_symbols
    UI.important("No R8 mapping.txt found under build/app/outputs/mapping/release") unless archived_r8_mapping

    File.write(
      File.join(symbols_dir, "manifest.txt"),
      [
        "version=#{app_version}",
        "git_rev=#{`git rev-parse --short HEAD`.strip}",
        "git_describe=#{`git describe --always --dirty`.strip}",
        "built_at=#{Time.now.utc.strftime("%Y-%m-%dT%H:%M:%SZ")}",
        "aab=#{aab_path}",
        "dart_symbols_dir=#{dart_symbols_dir}",
        "dart_symbols=#{dart_symbol_files.map { |path| File.basename(path) }.join(",")}",
        "native_debug_symbols=#{archived_native_symbols || ""}",
        "r8_mapping=#{archived_r8_mapping || ""}",
      ].join("\n") + "\n"
    )

    mapping_paths = [native_symbols_zip, r8_mapping].compact.select { |path| File.exist?(path) }

    upload_options = {
      track: "beta",
      aab: aab_path,
      json_key: play_store_json_key,
      package_name: "com.prismplural.prism",
      release_status: "completed",
    }
    upload_options[:mapping_paths] = mapping_paths unless mapping_paths.empty?

    # supply takes release notes via a metadata-dir layout; write the
    # changelog into a tmpdir so nothing persists under fastlane/metadata/.
    Dir.mktmpdir("prism-supply-metadata") do |meta_dir|
      changelog_dir = File.join(meta_dir, "en-US", "changelogs")
      FileUtils.mkdir_p(changelog_dir)
      File.write(File.join(changelog_dir, "#{app_version.split("+").last}.txt"), note)
      upload_to_play_store(**upload_options, metadata_path: meta_dir)
    end
    UI.success("Archived Android symbol files at #{symbols_dir}")
  end
end
